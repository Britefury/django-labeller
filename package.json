{
  "name": "django-labeller",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p ui/labelling_tool/tsconfig.json --noEmit && tsc -p ui/schema_editor/tsconfig.json --noEmit && node build.mjs",
    "build:labeller": "node build.mjs --labeller",
    "build:schema": "node build.mjs --schema",
    "watch": "node build.mjs --watch",
    "watch:labeller": "node build.mjs --watch --labeller",
    "watch:schema": "node build.mjs --watch --schema",
    "typecheck": "tsc -p ui/labelling_tool/tsconfig.json --noEmit && tsc -p ui/schema_editor/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
