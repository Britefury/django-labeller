{
  "name": "django-labeller",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p ui/labelling_tool/tsconfig.json && tsc -p ui/schema_editor/tsconfig.json",
    "build:labeller": "tsc -p ui/labelling_tool/tsconfig.json",
    "build:schema": "tsc -p ui/schema_editor/tsconfig.json",
    "watch": "concurrently \"tsc -p ui/labelling_tool/tsconfig.json --watch\" \"tsc -p ui/schema_editor/tsconfig.json --watch\"",
    "watch:labeller": "tsc -p ui/labelling_tool/tsconfig.json --watch",
    "watch:schema": "tsc -p ui/schema_editor/tsconfig.json --watch"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.8.0"
  }
}
